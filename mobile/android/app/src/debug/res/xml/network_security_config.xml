<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. Cleartext HTTP stays blocked everywhere except the two
  addresses a developer's own machine answers on:

    10.0.2.2  the Android emulator's alias for the host
    127.0.0.1 / localhost  a device forwarding a port with `adb reverse`

  Production traffic is https to Render and is unaffected by this file, which
  is not merged into a release build at all.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
