<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9 and later block cleartext HTTP, and the local dev backend is
         plain http on 10.0.2.2:3001 (the emulator's alias for the host). This
         config permits cleartext to that host and to loopback only, and lives
         in the debug source set so a release build is never affected. -->
    <application
        android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
