# Local-only backup docs — contains the DB backup decryption passphrase.
# NEVER commit: co-locating the passphrase with the repo would undermine the
# encryption of the patient-data backups.
DB_BACKUP_RESTORE.md

# Exports produced by scripts/drop_dependents.py. These hold real health data
# (names, blood types, allergies, medical conditions) pulled straight out of the
# database — they are backups, not source.
dependents_backup_*.json

# Environment files — NEVER commit secrets
.env
.env.*
!.env.example
server/.env
server/.env.*

# macOS
.DS_Store

# Logs
*.log

# Python bytecode cache (should never be tracked)
__pycache__/
*.py[cod]
.vercel

# Dependencies
node_modules/
venv/
.venv/
server/venv/
server/.venv/

# Firebase — secrets that must not be committed
server/serviceAccountKey.json
mobile/android/app/google-services.json
