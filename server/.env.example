# Copy to .env and fill in real values. NEVER commit the real .env.
# In production, prefer a secret manager over a plaintext .env file.

# development | production
# In production the app refuses to boot with default/placeholder secrets.
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Auth ---
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_min_32_chars_long_key_here

# --- AI providers ---
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here
GROQ_API_KEY=gsk_your_groq_api_key_here
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --- File storage (blobs live here, not in Postgres) ---
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# For STORAGE_BACKEND=s3 (AWS S3 / Supabase / R2 / MinIO). Requires `pip install boto3`.
# Supabase example: endpoint https://<project-ref>.storage.supabase.co/storage/v1/s3
# Keys are read from S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY below; if left blank,
# boto3 falls back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / IAM role.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Error monitoring (optional) ---
# Get a DSN from https://sentry.io (free tier). Empty = disabled.
SENTRY_DSN=

# --- CORS ---
# Comma-separated allowlist of frontend origins. Must NOT be "*" in production.
CORS_ORIGINS=*

# --- Outbound email (password reset links) ---
# Any SMTP provider works. Leave SMTP_HOST blank to disable sending: the reset
# email is then logged to the console instead, so the flow stays testable
# locally without a mail account.
# Gmail: enable 2-Step Verification, then create an App Password at
#   https://myaccount.google.com/apppasswords  (use it as SMTP_PASSWORD, no spaces).
# Note Gmail rewrites the From header to SMTP_USER, so keep SMTP_FROM's address
# the same as SMTP_USER or the mismatch can trip spam filters.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MediStore <no-reply@example.com>

# Base URL of the frontend, used to build the reset link in the email.
# Must be the real deployed origin in production, e.g. https://yourapp.vercel.app
FRONTEND_URL=http://localhost:3000