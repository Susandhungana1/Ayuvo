# Copy to .env and fill in real values. NEVER commit the real .env.
# In production, prefer a secret manager over a plaintext .env file.

# development | production
# In production the app refuses to boot with default/placeholder secrets.
ENVIRONMENT=development

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# --- Auth ---
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your_jwt_secret_min_32_chars_long_key_here

# --- AI providers ---
N8N_WEBHOOK_URL=http://localhost:5678/webhook

# --- File storage (blobs live here, not in Postgres) ---
# local | s3
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./storage
# For STORAGE_BACKEND=s3 (AWS S3 / Supabase / R2 / MinIO). Requires `pip install boto3`.
# Supabase example: endpoint https://<project-ref>.storage.supabase.co/storage/v1/s3
# Keys are read from S3_ACCESS_KEY_ID / S3_SECRET_ACCESS_KEY below; if left blank,
# boto3 falls back to AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / IAM role.
S3_BUCKET=
S3_REGION=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Error monitoring (optional) ---
# Get a DSN from https://sentry.io (free tier). Empty = disabled.
SENTRY_DSN=

# --- CORS ---
# Comma-separated allowlist of frontend origins. Must NOT be "*" in production.
CORS_ORIGINS=*

# --- Outbound email (password reset links) ---
# Two transports; the first one configured wins. With neither set, the email is
# logged to the console instead of sent, so the flow stays testable locally.
#
# 1) BREVO_API_KEY — sends over HTTPS (port 443).
#    REQUIRED on Render's free plan, which blocks outbound SMTP ports 25/465/587,
#    so an SMTP send there can only time out no matter how it's configured:
#    https://render.com/changelog/free-web-services-will-no-longer-allow-outbound-traffic-to-smtp-ports
#    Free tier is 300 emails/day. Sign up at https://www.brevo.com, then
#    SMTP & API > API Keys. Verify the SMTP_FROM address under Senders first,
#    or Brevo rejects the send with "Sender not valid".
#    Accounts created after May 2024 also allowlist caller IPs by default and
#    answer everyone else with a 401 that reads like a bad key. A host like
#    Render has no fixed outbound IP to allowlist, so under
#    Settings > Security > Authorised IPs either turn blocking off or add
#    0.0.0.0/0 and ::/0. Without that the key is valid and nothing ever sends.
BREVO_API_KEY=

# 2) SMTP — fine locally and on paid hosts.
#    Gmail: enable 2-Step Verification, then create an App Password at
#    https://myaccount.google.com/apppasswords (use as SMTP_PASSWORD, no spaces).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Sender identity for whichever transport is used. The address must be one the
# provider has verified. Note Gmail rewrites From to SMTP_USER, so keep this
# address the same as SMTP_USER or the mismatch can trip spam filters.
SMTP_FROM=Ayuvo <no-reply@example.com>

# Base URL of the frontend, used to build the reset link in the email.
# Must be the real deployed origin in production, e.g. https://yourapp.vercel.app
FRONTEND_URL=http://localhost:3000